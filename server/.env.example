# Copy this file to ".env" and fill in your values. NEVER upload .env to GitHub.
PORT=5000

# Local MongoDB (MongoDB Community installed on your PC):
MONGODB_URI=mongodb://127.0.0.1:27017/nzktechs
# Or MongoDB Atlas (free cloud):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nzktechs?retryWrites=true&w=majority

# Extra allowed origins for CORS (comma separated). Needed only when the HTML is opened with Live Server.
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Secret key to read messages at GET /api/contact (send it in the "x-admin-key" header). Use a long random text.
ADMIN_KEY=change-this-to-a-long-random-text

# ---------- Admin panel (open /admin in the browser) ----------
ADMIN_USER=admin
ADMIN_PASSWORD=use-a-strong-password-min-8-chars
SESSION_SECRET=a-very-long-random-text-min-16-chars

# ---------- Emails (Gmail example) ----------
# Gmail: enable 2-Step Verification, then create an "App password" and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourteam@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM_NAME=NZK Techs
TEAM_EMAIL=yourteam@gmail.com
PUBLIC_URL=http://localhost:5000
SITE_PHONE=03347127234
SITE_WHATSAPP=923347127234
